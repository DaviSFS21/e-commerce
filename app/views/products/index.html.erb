<% content_for :title, @category.name %>

<h1><%= @category.name %></h1>
<p class="sub">
  <%= pluralize(@facets.total, "produto") %> nesta categoria ·
  schema declarado pela categoria: <%= @category.field_specs.map(&:key).join(", ") %>
</p>

<nav class="tabs">
  <% @categories.each do |categoria| %>
    <%= link_to categoria.name, category_products_path(slug: categoria.slug),
                class: ("on" if categoria == @category) %>
  <% end %>
</nav>

<div class="layout">
  <aside class="facets">
    <% if params[:brand].present? || params[:min].present? || params[:max].present? %>
      <div class="facet">
        <h3>Filtros</h3>
        <div class="chips">
          <% if params[:brand].present? %><span class="chip"><%= params[:brand] %></span><% end %>
          <% if params[:min].present? || params[:max].present? %>
            <span class="chip"><%= money(@min_price) %> – <%= money(@max_price) %></span>
          <% end %>
        </div>
        <%= link_to "Limpar", category_products_path(slug: @category.slug), class: "btn ghost" %>
      </div>
    <% end %>

    <div class="facet">
      <h3>Preço</h3>
      <% maior = @facets.price_buckets.map(&:count).max.to_i %>
      <% if maior.positive? %>
        <div class="hist">
          <% @facets.price_buckets.each do |faixa| %>
            <span class="bar" style="height: <%= [ (faixa.count * 100 / maior), 8 ].max %>%"
                  title="<%= faixa.label %>: <%= faixa.count %>"></span>
          <% end %>
        </div>
      <% end %>

      <% piso = @facets.min_price.to_i %>
      <% teto = @facets.max_price.ceil.to_i %>
      <%= form_with url: category_products_path(slug: @category.slug), method: :get,
                    data: { controller: "price-range",
                            price_range_floor_value: piso,
                            price_range_ceil_value: teto } do %>
        <% if params[:brand].present? %>
          <%= hidden_field_tag :brand, params[:brand] %>
        <% end %>

        <div class="slider">
          <span class="slider-fill" data-price-range-target="fill"></span>
          <%= range_field_tag :min, @min_price.to_i, min: piso, max: teto, step: 1,
                              data: { price_range_target: "min", action: "input->price-range#refresh" } %>
          <%= range_field_tag :max, @max_price.ceil.to_i, min: piso, max: teto, step: 1,
                              data: { price_range_target: "max", action: "input->price-range#refresh" } %>
        </div>

        <p class="range">
          <span data-price-range-target="minLabel"><%= money(@min_price) %></span>
          –
          <span data-price-range-target="maxLabel"><%= money(@max_price) %></span>
        </p>

        <%= submit_tag "Aplicar", class: "btn", data: { turbo: false } %>
      <% end %>
    </div>

    <div class="facet">
      <h3>Marca</h3>
      <ul>
        <% @facets.brands.each do |marca| %>
          <li class="<%= "on" if params[:brand] == marca.key %>">
            <%= link_to marca.label,
                        filter_link(@category.slug, brand: (params[:brand] == marca.key ? nil : marca.key)) %>
            <span class="n"><%= marca.count %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </aside>

  <section>
    <% if @products.empty? %>
      <p class="empty">Nenhum produto com esses filtros.</p>
    <% else %>
      <div class="grid">
        <%= render partial: "products/product", collection: @products, as: :produto %>
      </div>
    <% end %>
  </section>
</div>
